# Cloudflare Pages Edge Performance & Security Headers
# Domain: tysonshields.com

# Fonts - 1 Year Immutable Edge Cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: max-age=31536000
  CDN-Cache-Control: max-age=31536000
  Access-Control-Allow-Origin: *

# Static Images & Icons - 30-Day Immutable Edge Cache
/assets/images/*
  Cache-Control: public, max-age=2592000, immutable
  Cloudflare-CDN-Cache-Control: max-age=2592000

/assets/icons/*
  Cache-Control: public, max-age=2592000, immutable
  Cloudflare-CDN-Cache-Control: max-age=2592000

# Documents - 1-Day Edge & Browser Cache with Stale-While-Revalidate
/assets/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: max-age=604800

# Stylesheets & Scripts - Edge & Browser Cache
/styles.min.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: max-age=604800

/styles.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: max-age=604800

/scripts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: max-age=604800

# Root Favicon & Web Manifest
/favicon.ico
  Cache-Control: public, max-age=2592000, immutable
  Cloudflare-CDN-Cache-Control: max-age=2592000

/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Cloudflare-CDN-Cache-Control: max-age=604800

# Global Security Headers across all routes
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://generativelanguage.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:;
