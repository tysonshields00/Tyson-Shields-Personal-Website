{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:;" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/legacy/index.html" },
    { "source": "/about", "destination": "/legacy/about.html" },
    { "source": "/career", "destination": "/legacy/career.html" },
    { "source": "/skills", "destination": "/legacy/skills.html" },
    { "source": "/contact", "destination": "/legacy/contact.html" },
    { "source": "/about.html", "destination": "/legacy/about.html" },
    { "source": "/career.html", "destination": "/legacy/career.html" },
    { "source": "/skills.html", "destination": "/legacy/skills.html" },
    { "source": "/contact.html", "destination": "/legacy/contact.html" },
    { "source": "/index.html", "destination": "/legacy/index.html" },
    { "source": "/Tyson-Shields-Resume.html", "destination": "/legacy/Tyson-Shields-Resume.html" },
    { "source": "/scripts/(.*)", "destination": "/legacy/scripts/$1" },
    { "source": "/fonts/(.*)", "destination": "/legacy/fonts/$1" },
    { "source": "/styles.min.css", "destination": "/legacy/styles.min.css" },
    { "source": "/styles.css", "destination": "/legacy/styles.css" },
    { "source": "/favicon.ico", "destination": "/legacy/favicon.ico" },
    { "source": "/favicon-16x16.png", "destination": "/legacy/favicon-16x16.png" },
    { "source": "/favicon-32x32.png", "destination": "/legacy/favicon-32x32.png" },
    { "source": "/apple-touch-icon.png", "destination": "/legacy/apple-touch-icon.png" },
    { "source": "/android-chrome-192x192.png", "destination": "/legacy/android-chrome-192x192.png" },
    { "source": "/android-chrome-512x512.png", "destination": "/legacy/android-chrome-512x512.png" },
    { "source": "/icon.svg", "destination": "/legacy/icon.svg" },
    { "source": "/headshot.jpg", "destination": "/legacy/headshot.jpg" },
    { "source": "/tyson-shields-headshot.jpg", "destination": "/legacy/tyson-shields-headshot.jpg" },
    { "source": "/og-image.png", "destination": "/legacy/og-image.png" },
    { "source": "/robots.txt", "destination": "/legacy/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/legacy/sitemap.xml" },
    { "source": "/site.webmanifest", "destination": "/legacy/site.webmanifest" },
    { "source": "/Tyson-Shields-Resume.pdf", "destination": "/legacy/Tyson-Shields-Resume.pdf" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/legacy/404.html" }
  ]
}
